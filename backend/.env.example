FLASK_APP=app
FLASK_DEBUG=1
SECRET_KEY=replace-me

MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=pricescope
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000

FIREBASE_CREDENTIALS_PATH=

# The only browser origin allowed to call the API (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Background price scraping. Off by default so CLI commands, tests and extra
# processes never start a scheduler; enable it on the one server process.
SCHEDULER_ENABLED=false
SCRAPE_INTERVAL_HOURS=6

# Alert emails over SMTP. Leave SMTP_HOST empty to disable sending.
# Gmail: smtp.gmail.com, port 587, starttls, and an app password as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
